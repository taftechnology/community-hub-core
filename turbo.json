{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "eslint.config.js",
    "tooling/eslint-plugin-community-hub/**",
    ".github/workflows/ci.yml"
  ],
  "tasks": {
    "lint": {},
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@community-hub/db#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/modules/core/*/db/schema.ts"]
    },
    "@community-hub/tenancy#test": {
      "dependsOn": ["^build", "@community-hub/db#test"]
    },
    "@community-hub/identity#test": {
      "dependsOn": ["^build", "@community-hub/db#test", "@community-hub/tenancy#test"]
    },
    "@community-hub/entitlements#test": {
      "dependsOn": ["^build", "@community-hub/tenancy#test", "@community-hub/access#test"]
    },
    "@community-hub/billing#test": {
      "dependsOn": ["^build", "@community-hub/entitlements#test"]
    },
    "@community-hub/api#test": {
      "dependsOn": ["^build", "@community-hub/billing#test"]
    },
    "@community-hub/usage#test": {
      "dependsOn": ["^build", "@community-hub/identity#test"]
    },
    "@community-hub/people#test": {
      "dependsOn": ["^build", "@community-hub/usage#test"]
    },
    "@community-hub/access#test": {
      "dependsOn": ["^build", "@community-hub/people#test"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
