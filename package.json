{
  "name": "community-hub-core",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:boundaries": "tsx tooling/checks/run.ts",
    "gate": "tsx tooling/checks/gate/cli.ts"
  },
  "pnpm": {
    "overrides": {
      "undici": ">=7.29.1 <8",
      "ws": ">=8.21.0",
      "sharp": ">=0.35.4"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@typescript-eslint/utils": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^4.1.11"
  }
}
