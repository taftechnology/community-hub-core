      {
        "name": "Headings",
        "family": "sans",
        "styles": [
          {
            "name": "page-title",
            "fontSize": "22px",
            "lineHeight": "28px",
            "fontWeight": 700,
            "letterSpacing": "-0.005em",
            "sample": "All Contacts",
            "usage": "The screen title in the top bar, one per screen, Title Case."
          },
          {
            "name": "section-title",
            "fontSize": "18px",
            "lineHeight": "24px",
            "fontWeight": 600,
            "sample": "Contact details",
            "usage": "In-page section headings."
          },
          {
            "name": "panel-title",
            "fontSize": "16px",
            "lineHeight": "22px",
            "fontWeight": 600,
            "sample": "Guardians",
            "usage": "Panel and table headers, dialog sections."
          },
          {
            "name": "stat",
            "fontSize": "28px",
            "lineHeight": "34px",
            "fontWeight": 700,
            "sample": "1,284",
            "usage": "The figure on a statistic card."
          }
        ]
      },
      {
        "name": "Text",
        "family": "sans",
        "styles": [
          {
            "name": "form-text",
            "fontSize": "16px",
            "lineHeight": "24px",
            "fontWeight": 400,
            "sample": "Daniel Bennett",
            "usage": "Values in fields and detail views, long reading text."
          },
          {
            "name": "notice",
            "fontSize": "15px",
            "lineHeight": "22px",
            "fontWeight": 400,
            "sample": "Someone else changed this record.",
            "usage": "Alerts, subtitles, empty-state sentences."
          },
          {
            "name": "label",
            "fontSize": "15px",
            "lineHeight": "22px",
            "fontWeight": 600,
            "sample": "Email address",
            "usage": "Field labels."
          },
          {
            "name": "body",
            "fontSize": "14px",
            "lineHeight": "20px",
            "fontWeight": 400,
            "sample": "daniel.b@example.org",
            "usage": "Table cells, sidebar items, menus."
          },
          {
            "name": "body-strong",
            "fontSize": "14px",
            "lineHeight": "20px",
            "fontWeight": 600,
            "sample": "Daniel Bennett",
            "usage": "The first column of a table, selected items."
          },
          {
            "name": "button",
            "fontSize": "14px",
            "lineHeight": "20px",
            "fontWeight": 600,
            "sample": "Save contact details",
            "usage": "Button labels, sentence case."
          },
          {
            "name": "column",
            "fontSize": "13px",
            "lineHeight": "18px",
            "fontWeight": 600,
            "sample": "Email",
            "usage": "Table column headings."
          },
          {
            "name": "meta",
            "fontSize": "13px",
            "lineHeight": "18px",
            "fontWeight": 400,
            "sample": "Updated 2 Nov 2026",
            "usage": "Helper text and dates that are also available elsewhere."
          },
          {
            "name": "nav-heading",
            "fontSize": "12px",
            "lineHeight": "16px",
            "fontWeight": 600,
            "sample": "People",
            "usage": "Sidebar section headings, sentence case."
          }
        ]
      }
    ]
  },
  "spacing": {
    "tokens": [
      {
        "name": "space-1",
        "value": "4px",
