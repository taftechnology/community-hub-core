{
  "name": "@community-hub/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./theme.css"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --build && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "build": "tsc --build",
    "generate": "pnpm exec tsx src/write-theme-css.ts && pnpm exec prettier --write theme.css",
    "shadcn": "node scripts/run-shadcn.mjs"
  },
  "peerDependencies": {
    "@community-hub/tokens": "workspace:*",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@community-hub/tokens": "workspace:*",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.13.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
