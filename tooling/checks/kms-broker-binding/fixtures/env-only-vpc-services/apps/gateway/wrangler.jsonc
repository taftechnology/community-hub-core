{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-10",
  "compatibility_flags": [
    "nodejs_als"
  ],
  "workers_dev": false,
  "preview_urls": true,
  "env": {
    "production": {
      "vpc_services": [
        {
          "binding": "OTHER",
          "service_id": "x"
        }
      ]
    }
  }
}
